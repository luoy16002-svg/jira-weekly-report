# Copy to .env and fill in. The token never leaves your machine except in requests to your own Jira site.
JIRA_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=paste-your-api-token-here
JIRA_BOARD_ID=12
# Optional: the custom field that holds story points on your site (see README)
JIRA_STORY_POINTS_FIELD=customfield_10016
# Optional: heading on the report
REPORT_TITLE=Weekly development report
